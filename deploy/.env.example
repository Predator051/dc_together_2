# Код приглашения для входа в игру (любые 8 латинских букв/цифр, можно с дефисом).
# Если оставить пустым — сервер придумает код сам и напишет его в логах.
INVITE_CODE=

# Адрес сайта.
#   :80               — игра по IP-адресу сервера, без HTTPS
#   game.example.com  — свой домен, HTTPS включится автоматически
SITE_ADDRESS=:80

# Порты на сервере. Пока на 80/443 работает первая часть, вторая живёт на 8081.
# Когда первую часть остановите — можно поставить 80 и 443.
HTTP_PORT=8081
HTTPS_PORT=8444
